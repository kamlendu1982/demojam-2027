---
# Inventory of Arista virtual switches to be registered in NetBox.
#
# Kept separate from ./inventory (used by deploy_arista_lab.yml) on purpose:
# that inventory's playbook targets `hosts: all` to SSH into the Ubuntu VM
# and install Docker/Containerlab - switch1/switch2 are not SSH-reachable
# hosts and must never be swept into that play.
#
# This file is the ONLY definition of the switches. In AAP it is loaded by
# the "DemoJam | Arista Devices" SCM inventory source into the
# "DemoJam | Add Switches" inventory (see aap_config/). Do not add the
# switches to any other AAP inventory by hand.
#
# No passwords here: in AAP the "DemoJam | Arista Switch Login" credential
# injects ansible_user / ansible_password / ansible_become_password. For CLI
# runs pass them with -e (or --ask-pass).
all:
  children:
    arista_switches:
      vars:
        # 172.20.20.0/24 is Containerlab's internal management bridge on the
        # Ubuntu VM (Container Lab host, 10.1.0.32) - it isn't routable from
        # outside that VM, so SSH to the switches jumps through it.
        #
        # ProxyCommand (not ProxyJump): this is the form that worked from AAP
        # with network_cli. The jump uses the "DemoJam | Ubuntu SSH" key,
        # which AAP loads into ssh-agent when that credential is attached.
        #
        # Used by every playbook that connects to the switches (Splunk
        # logging, security policies, revert-network-config-from-netbox.yml).
        # netbox_onboard_switches.yml only reads ansible_host.
        ansible_ssh_common_args: >-
          -o StrictHostKeyChecking=no
          -o ProxyCommand="ssh -W %h:%p -o StrictHostKeyChecking=no ubuntu@10.1.0.32"

        ansible_connection: ansible.netcommon.network_cli
        ansible_network_os: arista.eos.eos
        ansible_user: admin
        ansible_become: true
        ansible_become_method: enable
      hosts:
        # Replace with the actual management IPs assigned by Containerlab.
        # Find them with: sudo containerlab inspect -t /opt/arista-lab/lab.clab.yml
        switch1:
          ansible_host: 172.20.20.3
        switch2:
          ansible_host: 172.20.20.2
