# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.
#
# This file configures a DETERMINISTIC 4-agent network-drift workflow:
#   Agent 1  DeviceDriftDetector      -> NetBox (MCP)  : classify + detect networking drift
#   Agent 2  NetBoxRemediator         -> AAP           : revert networking drift to NetBox truth
#   Agent 3  SecurityPolicyDrift      -> GitHub (MCP)  : detect security-policy drift
#   Agent 4  GitHubRemediator         -> AAP           : revert security drift to GitHub truth
#
# Control flow between agents is 100% deterministic Python (see src/pipeline/orchestrator.py).
# The LLM is ONLY used at two bounded points: (1) classifying an attribute as
# "security" vs "networking" when it is not already in config/attribute_classification.yaml,
# and (2) producing a human-readable summary string. It never decides drift=true/false itself.

# ────────────────────────────────────────────────────────────────────────────
# LLM — Model as a Service (MaaS), OpenAI-compatible
# ────────────────────────────────────────────────────────────────────────────
MAAS_API_BASE=https://your-maas-endpoint.example.com/v1
MAAS_API_KEY=your_maas_api_key_here
MAAS_MODEL=llama-4-scout-17b-16e-w4a16

# ────────────────────────────────────────────────────────────────────────────
# NetBox — source of truth for NETWORKING configuration (Agent 1 / Agent 2)
# Reached exclusively over MCP (Model Context Protocol).
#
# There are TWO distinct pairs of NetBox settings below — do not confuse them.
# ────────────────────────────────────────────────────────────────────────────

# --- Real NetBox instance credentials -----------------------------------
# Required when NETBOX_MCP_TRANSPORT=stdio: these are passed into the
# environment of the locally-spawned NetBox MCP server subprocess (e.g.
# netboxlabs/netbox-mcp-server reads exactly these two env var names).
# For testing today these live here in .env; ultimately NETBOX_URL will be
# passed as an AAP Job Template extra_var and NETBOX_TOKEN injected via an
# AAP Custom Credential (see network-drift-manager.yaml).
NETBOX_URL=https://netbox.example.com/
NETBOX_TOKEN=your_netbox_api_token_here

# --- Transport selection for the NetBox MCP server ----------------------
# "stdio" : spawn a local command (e.g. an embedded netbox-mcp-server) that
#           speaks MCP over stdin/stdout. This is the mode used when the
#           NetBox MCP server runs inside the same Execution Environment.
# "http"  : connect to an already-running, separately-hosted NetBox MCP
#           server over streamable-HTTP at NETBOX_MCP_URL.
NETBOX_MCP_TRANSPORT=stdio

# --- Only used when NETBOX_MCP_TRANSPORT=stdio --------------------------
# Command used to launch the embedded NetBox MCP server, e.g.:
# NETBOX_MCP_COMMAND=uv run netbox-mcp-server
NETBOX_MCP_COMMAND=

# --- Only used when NETBOX_MCP_TRANSPORT=http ---------------------------
# URL + bearer token for an EXTERNALLY-HOSTED NetBox MCP server's own HTTP
# endpoint (its MCP_AUTH_TOKEN — NOT the NetBox API token above).
NETBOX_MCP_URL=https://netbox-mcp.example.com/mcp
NETBOX_MCP_TOKEN=your_netbox_mcp_server_bearer_token

NETBOX_VERIFY_SSL=true
# Optional override if auto tool-discovery picks the wrong tool name on your
# NetBox MCP server. Leave blank to auto-discover (searches for a tool whose
# name contains "device" and "get"/"list").
NETBOX_MCP_DEVICE_TOOL=

# ────────────────────────────────────────────────────────────────────────────
# GitHub — source of truth for SECURITY policy (Agent 3 / Agent 4)
# Reached exclusively over MCP (official github-mcp-server or hosted equivalent).
# ────────────────────────────────────────────────────────────────────────────
GITHUB_MCP_TRANSPORT=http
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=your_github_pat_with_repo_read
# Only used when GITHUB_MCP_TRANSPORT=stdio, e.g.:
# GITHUB_MCP_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
GITHUB_MCP_COMMAND=

# Where the security policy "source of truth" files live in GitHub.
# One file per device; {device} is substituted with the device name.
GITHUB_POLICY_REPO_OWNER=your-org
GITHUB_POLICY_REPO_NAME=network-security-policies
GITHUB_POLICY_BRANCH=main
GITHUB_POLICY_PATH_TEMPLATE=security-policies/{device}.yml

# ────────────────────────────────────────────────────────────────────────────
# AAP (Ansible Automation Platform) Controller — remediation (Agent 2 / Agent 4)
# ────────────────────────────────────────────────────────────────────────────
AAP_URL=https://your-aap-controller.example.com
AAP_TOKEN=your_aap_api_token_here
AAP_VERIFY_SSL=false

# Job template used to revert NETWORKING drift back to NetBox values.
# Accepts either a numeric ID or the exact template name.
AAP_JOB_TEMPLATE_NETBOX_REMEDIATION=revert-network-config-from-netbox

# Job template used to revert SECURITY drift back to GitHub policy values.
AAP_JOB_TEMPLATE_GITHUB_REMEDIATION=revert-security-config-from-github

# Name of the extra_var key used to tell the playbook which device to target.
AAP_EXTRA_VARS_DEVICE_KEY=device_name

# ────────────────────────────────────────────────────────────────────────────
# Agent / Pipeline behaviour
# ────────────────────────────────────────────────────────────────────────────
# true  = compute drift and print the remediation plan (extra_vars) WITHOUT
#         launching any AAP job.
# false = actually launch the AAP job template(s) when drift is found.
DRY_RUN=true

# true  = never talk to real NetBox/GitHub/AAP/LLM MCP endpoints — use the
#         local fixtures under demo_fixtures/ instead. Great for a live demo
#         without network access or live credentials.
DEMO_MODE=true

LOG_LEVEL=INFO
